# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local Python venv (analyse ventes)
private/sales/.venv/
private/sales/.mplconfig/
private/sales/.matplotlib/
# exports billetterie (données personnelles)
private/sales/*.xlsx
private/sales/*.csv
private/sacem/facture-sacem.config.json
# CERFA générés (documents fiscaux)
private/cerfa/*.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
