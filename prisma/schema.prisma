generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Volunteer {
  id             String          @id @default(cuid())
  name           String
  email          String
  phone          String?
  age            Int?
  profileImage   String?
  disponibilites String[]
  missions       String[]
  experience     String?
  message        String?
  status         VolunteerStatus @default(PENDING)
  team           String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  needsParking   Boolean?
}

model Partner {
  id             String        @id @default(cuid())
  company        String
  contact        String
  email          String
  phone          String?
  tier           String?
  message        String?
  status         PartnerStatus @default(PENDING)
  logo           String?
  siret          String?
  address        String?
  donationAmount Float?
  donationDate   DateTime?
  receiptNumber  String?
  receiptDate    DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assignedToId   String?
  website        String?
  invoiceDate    DateTime?
  invoiceNumber  String?
  invoices       Invoice[]
  assignedTo     AdminUser?    @relation(fields: [assignedToId], references: [id])
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  invoiceDate   DateTime  @default(now())
  clientName    String
  clientSiret   String?
  clientAddress String?
  clientContact String?
  clientEmail   String?
  lines         String
  totalAmount   Float
  paymentDate   DateTime?
  paymentMethod String?   @default("virement")
  partnerId     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  partner       Partner?  @relation(fields: [partnerId], references: [id])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("admin")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  partners     Partner[]
}

model TremplinBand {
  id                 String         @id @default(cuid())
  bandName           String
  genre              String
  city               String
  formationYear      Int?
  contactName        String
  contactEmail       String
  contactPhone       String
  members            String
  bio                String
  youtubeLink        String?
  spotifyLink        String?
  bandcampLink       String?
  facebookLink       String?
  instagramLink      String?
  otherLink          String?
  photoUrl           String?
  demoUrl            String?
  motivation         String?
  status             TremplinStatus @default(PENDING)
  notes              String?
  rating             Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  rejectionEmailSent Boolean        @default(false)
}

model VillageStand {
  id          String               @id @default(cuid())
  name        String
  category    VillageStandCategory
  description String?
  logo        String?
  website     String?
  instagram   String?
  facebook    String?
  contact     String?
  email       String?
  phone       String?
  isVisible   Boolean              @default(true)
  order       Int                  @default(0)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Band {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  day          String
  order        Int      @default(0)
  time         String?
  endTime      String?
  description  String
  imageUrl     String?
  videoUrl     String?
  website      String?
  facebook     String?
  instagram    String?
  spotify      String?
  techRiderUrl String?
  contractUrl  String?
  notes        String?
  isVisible    Boolean  @default(true)
  isHeadliner  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ComptaCategory {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         String
  parentCode   String?
  tags         String?
  transactions Transaction[]
}

model Transaction {
  id           String          @id @default(cuid())
  date         DateTime
  valueDate    DateTime?
  label        String
  description  String?
  amount       Decimal         @db.Decimal(10, 2)
  type         String
  categoryId   String?
  sourceFile   String?
  isReconciled Boolean         @default(false)
  notes        String?
  exerciceYear Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  category     ComptaCategory? @relation(fields: [categoryId], references: [id])

  @@index([exerciceYear])
  @@index([categoryId])
}

model ComptaExercice {
  id             String   @id @default(cuid())
  year           Int      @unique
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean  @default(false)
  openingBalance Decimal  @db.Decimal(10, 2)
  closingBalance Decimal? @db.Decimal(10, 2)
}

model FestivalDay {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  date        DateTime
  openingTime String
  closingTime String?
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FestivalSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  description       String
  type              ProductType      @default(LOCAL)
  images            String[]
  printifyProductId String?
  isVisible         Boolean          @default(true)
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orderItems        OrderItem[]
  variants          ProductVariant[]
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  name              String
  size              String?
  color             String?
  price             Decimal     @db.Decimal(10, 2)
  stock             Int         @default(0)
  printifyVariantId String?
  sku               String?
  isAvailable       Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  customerEmail   String
  customerName    String
  customerPhone   String?
  shippingAddress String
  stripePaymentId String?     @unique
  stripeSessionId String?     @unique
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingCost    Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  printifyOrderId String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(10, 2)
  productName String
  variantName String
  order       Order          @relation(fields: [orderId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
}

enum VolunteerStatus {
  PENDING
  VALIDATED
  REFUSED
}

enum PartnerStatus {
  PENDING
  CONTACTED
  VALIDATED
  REFUSED
}

enum TremplinStatus {
  PENDING
  PRESELECTED
  SELECTED
  REJECTED
}

enum VillageStandCategory {
  FOOD
  BAR
  MERCHANDISING
  ARTISANAT
  TATTOO
  BARBIER
  ASSOCIATION
  DIVERS
}

enum ProductType {
  LOCAL
  PRINTIFY
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model CarpoolOffer {
  id          String        @id @default(cuid())
  type        CarpoolType
  name        String
  city        String
  lat         Float?
  lng         Float?
  seats       Int?
  days        String[]
  message     String?
  email       String
  deleteToken String        @unique @default(cuid())
  status      CarpoolStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum CarpoolType {
  DRIVER
  PASSENGER
}

enum CarpoolStatus {
  PENDING
  VISIBLE
  HIDDEN
}
